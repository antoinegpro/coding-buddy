<% sheets = @user.cheat_sheets.includes(:chat).order(created_at: :desc) %>
<% chats = @user.respond_to?(:chats) ? @user.chats : Chat.none %>
<% finished = chats.where.not(score: nil) %>
<% average = finished.average(:score) %>
<% name = @user.try(:first_name).presence || @user.email.split("@").first.capitalize %>

<div class="profile container py-5">

  <%= link_to root_path, class: "profile-back" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Tous les thèmes
  <% end %>

  <h1 class="profile-title">Ton <span>profil</span></h1>

  <div class="profile-hello">
    <%= image_tag "logo_robot.svg", class: "profile-robot", alt: "" %>
    <div class="profile-bubble">
      <strong>Coding Buddy</strong>
      <% if sheets.any? %>
        Salut <%= name %> ! Tu as <%= sheets.size %> fiche<%= "s" if sheets.size > 1 %> prête<%= "s" if sheets.size > 1 %> à réviser. On continue ?
      <% else %>
        Salut <%= name %> ! Fais ton premier quiz, et je te prépare ta première fiche.
      <% end %>
    </div>
  </div>

  <div class="profile-stats">
    <div class="profile-stat">
      <small>Quiz terminés</small>
      <span><%= finished.count %></span>
    </div>
    <div class="profile-stat">
      <small>Score moyen</small>
      <span><%= average ? "#{average.to_f.round(1)} / 5" : "–" %></span>
    </div>
    <div class="profile-stat">
      <small>Cheat sheets</small>
      <span><%= sheets.size %></span>
    </div>
  </div>

  <h2 class="profile-section">Tes cheat sheets</h2>

  <% if sheets.any? %>
    <div class="row row-cols-1 row-cols-md-2 g-3">
      <% sheets.each do |sheet| %>
        <div class="col">
          <%= link_to cheat_sheet_path(sheet), class: "profile-card" do %>
            <span class="profile-card-icon">
              <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
            </span>
            <span class="profile-card-title">
              <%= sheet.chat.title.presence || "Cheat sheet ##{sheet.id}" %>
            </span>
            <span class="profile-card-date">
              Créée le <%= sheet.created_at.strftime("%d/%m/%Y") %>
            </span>
            <span class="profile-card-cta">Ouvrir la fiche →</span>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= link_to "Lancer un nouveau quiz →", root_path, class: "profile-button" %>
  <% else %>
    <div class="profile-empty">
      <span class="profile-card-icon">
        <i class="fa-solid fa-book-open" aria-hidden="true"></i>
      </span>
      <strong>Ta première fiche t'attend</strong>
      <p>Fais un quiz, discute avec l'IA, puis génère ta cheat sheet pour ne rien oublier.</p>
      <%= link_to "Lancer un quiz", root_path, class: "profile-button profile-button-inline" %>
    </div>
  <% end %>

</div>

