<div class="cheatsheet container py-5">

  <header class="mb-4">
    <h1 class="cheatsheet-title mb-3"><%= @cheat_sheet.title %></h1>

    <div class="d-flex flex-wrap align-items-center gap-3">
      <span class="cheatsheet-chip cheatsheet-chip-blue">
        Catégorie : <%= @cheat_sheet.chat.category.name %>
      </span>
      <span class="cheatsheet-chip">
        Score au quiz : <%= @cheat_sheet.chat.score %> / <%= @cheat_sheet.chat.quiz_questions.count %>
      </span>
      <span class="cheatsheet-date">
        Créée le <%= @cheat_sheet.created_at.strftime("%d/%m/%Y") %>
      </span>
    </div>
  </header>

  <div class="row g-4">

    <div class="col-lg-9">
      <article class="cheatsheet-card">
        <div class="markdown-content cheatsheet-content">
          <%= sanitize(render_markdown(@cheat_sheet.content)) %>
        </div>
      </article>
    </div>

    <div class="col-lg-3">
      <nav class="cheatsheet-actions sticky-lg-top d-flex flex-column gap-3 p-3" aria-label="Actions">
        <%= link_to download_cheat_sheet_path(@cheat_sheet),
                    class: "btn cheatsheet-btn cheatsheet-btn-primary" do %>
          <i class="fa-solid fa-download me-2" aria-hidden="true"></i>
          Télécharger ma fiche de révision
        <% end %>

        <%= link_to "Accéder à mon profil",
                    user_path(current_user),
                    class: "btn cheatsheet-btn" %>

        <%= link_to "Commencer un nouveau quiz",
                    root_path,
                    class: "btn cheatsheet-btn" %>
      </nav>
    </div>
  </div>
</div>
