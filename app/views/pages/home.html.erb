<div class="home container py-5">

  <header class="text-center mb-5">
    <h1 class="home-title mb-3">
      Teste tes connaissances en <span>code</span>
    </h1>
    <p class="home-subtitle mx-auto mb-0">
      Ton compagnon IA pour réviser. Choisis un thème, discute avec lui
      et génère tes cheat sheets pour ne rien oublier.
    </p>
  </header>

  <div class="theme-grid row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3 justify-content-center">
    <% @categories.each do |category| %>
      <% theme = category_theme(category) %>

      <div class="col">
        <%= button_to chats_path,
                      method: :post,
                      params: { category_id: category.id },
                      form_class: "h-100",
                      data: {
                        controller: "quiz-card",
                        action: "click->quiz-card#start"
                      },
                      class: "card theme-card w-100 h-100 p-4 text-start" do %>

          <span class="theme-card-icon mb-3">
            <i class="fa-solid <%= theme[:icon] %>" aria-hidden="true"></i>
          </span>
          <span class="theme-card-title mb-2"><%= theme[:label] %></span>
          <span class="theme-card-description mb-3"><%= theme[:description] %></span>
          <span class="theme-card-cta mt-auto">Lancer le quiz →</span>

          <span class="quiz-loading">
            <%= image_tag "logo_robot.svg", class: "quiz-robot", alt: "", height: 48 %>
            <span class="quiz-message" data-quiz-card-target="message" aria-live="polite">Génération du quiz…</span>
            <span class="quiz-dots"><span></span><span></span><span></span></span>
          </span>

        <% end %>
      </div>
    <% end %>
  </div>

  <ol class="home-steps row row-cols-1 row-cols-md-3 g-4 list-unstyled mt-5 pt-2 mb-0">
    <li class="col d-flex gap-3">
      <span class="home-step-number">1</span>
      <div>
        <strong class="d-block">Choisis un thème</strong>
        <span class="home-step-text">Un quiz est généré pour t'entraîner.</span>
      </div>
    </li>
    <li class="col d-flex gap-3">
      <span class="home-step-number">2</span>
      <div>
        <strong class="d-block">Discute avec l'IA</strong>
        <span class="home-step-text">Pose tes questions sur ce que tu n'as pas compris.</span>
      </div>
    </li>
    <li class="col d-flex gap-3">
      <span class="home-step-number">3</span>
      <div>
        <strong class="d-block">Garde une cheat sheet</strong>
        <span class="home-step-text">Génère ta fiche pour ne rien oublier.</span>
      </div>
    </li>
  </ol>
</div>

<style>
  .theme-card {
    position: relative;
    overflow: hidden;
    transition: opacity 0.3s ease, transform 0.3s ease,
                box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .theme-card .quiz-loading {
    display: none;
  }

  .theme-grid.has-loading .theme-card:not(.is-loading) {
    opacity: 0.35 !important;
    transform: scale(0.96) !important;
    pointer-events: none;
  }

  .theme-grid .theme-card.is-loading {
    cursor: wait;
    transform: translateY(-4px);
    border-color: #316CF4;
    box-shadow: 0 0 0 4px rgba(49, 108, 244, 0.15);
  }

  .theme-card.is-loading > *:not(.quiz-loading) {
    visibility: hidden;
  }

  .theme-card.is-loading .quiz-loading {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    text-align: center;
  }

  .quiz-robot {
    height: 48px;
    width: auto;
    animation: robot-float 1.2s ease-in-out infinite;
  }

  .quiz-message {
    display: block;
    max-width: 180px;
    font-size: 0.85rem;
    font-weight: 400;
    line-height: 1.4;
    color: #6c757d;
  }

  .quiz-dots {
    display: flex;
    gap: 6px;
  }

  .quiz-dots span {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #316CF4;
    animation: dot-bounce 1s ease-in-out infinite;
  }

  .quiz-dots span:nth-child(2) { animation-delay: 0.15s; }
  .quiz-dots span:nth-child(3) { animation-delay: 0.3s; }

  @keyframes robot-float {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50%      { transform: translateY(-8px) rotate(4deg); }
  }

  @keyframes dot-bounce {
    0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
    40%           { transform: scale(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .quiz-robot, .quiz-dots span { animation: none; }
  }
</style>
