<div class="container py-4">

  <h1><%= @chat.title %></h1>

  <p>Question <%= @position %> / <%= @total %></p>

  <div class="progress mb-4">
    <div class="progress-bar"
         style="width: <%= (@position - 1).to_f / @total * 100 %>%">
    </div>
  </div>

  <% if @last_answer.present? %>

  <% if @last_answer.correct %>

    <div class="alert alert-success">
      <strong>Bonne réponse !</strong>
      <p><%= @last_answer.feedback %></p>
    </div>

  <% else %>

    <div class="alert alert-danger">
      <strong>Mauvaise réponse !</strong>
      <p><%= @last_answer.feedback %></p>
    </div>

  <% end %>

<% end %>

  <h2><%= @question.content %></h2>

<%= form_with url: chat_messages_path(@chat),
              method: :post,
              data: { turbo: false } do %>
    <%= hidden_field_tag :question_id, @question.id %>

    <% @question.choices.each_with_index do |choice, index| %>

      <div class="border rounded p-3 mb-3">

        <%= radio_button_tag :choice, index, false,
                             required: true %>

        <%= label_tag "choice_#{index}", choice %>

      </div>

    <% end %>

    <%= submit_tag "Valider ma réponse",
                   class: "btn btn-primary w-100" %>

  <% end %>

</div>
