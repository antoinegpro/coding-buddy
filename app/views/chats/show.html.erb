<%= link_to @chat.category.name, chat_path(@chat) %>

<h1 id="chat_title"><%= @chat.title %></h1>

<div id="messages">
  <% @chat.messages.each do |message| %>
    <div class="message">
      <%= message.role %>
      <%= sanitize(render_markdown(message.content)) %>
    </div>
  <% end %>
</div>

<div id="new_message_container">
  <%= simple_form_for [@chat, @message] do |f| %>
    <%= f.input :content,
      label: "Ask a question",
      required: true,
      placeholder: "How should I get started with the categories?" %>

    <%= f.button :submit, 'Ask LLM', class: 'btn btn-primary' %>
  <% end %>
</div>