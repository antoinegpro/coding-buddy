<%= turbo_stream_from @chat, :companion %>
  <div class="companion container py-4">

    <header class="d-flex flex-wrap justify-content-between align-items-center gap-4 mb-4">
      <div>
        <h1 class="companion-title mb-3">Ton compagnon <span>IA</span></h1>
        <span class="companion-category">Catégorie : <%= @chat.category.name %></span>
      </div>

      <div class="companion-card d-flex align-items-center gap-4 px-4 py-3">
        <div>
          <h2 class="companion-score-title mb-1">Quiz terminé !</h2>
          <span class="companion-muted">Ton score</span>
        </div>
        <strong class="companion-score"><%= @score %> / <%= @total %></strong>
      </div>
    </header>

    <div class="row g-4">

      <section class="col-lg-12">
        <% if @mistakes.any? %>
          <h2 class="companion-section-title mb-3">Les notions à revoir</h2>

          <div class="row g-3">
            <% @mistakes.each do |mistake| %>
              <div class="col-lg-6">
                <article class="companion-card p-3 h-100">
                  <span class="companion-topic mb-2"><%= mistake[:topic] %></span>
                  <p class="fw-medium"><%= mistake[:question] %></p>

                  <div class="row row-cols-1 row-cols-sm-2 g-2">
                    <div class="col">
                      <div class="companion-answer companion-answer-wrong">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        <span>Ta réponse : <strong><%= mistake[:user_answer] %></strong></span>
                      </div>
                    </div>
                    <div class="col">
                      <div class="companion-answer companion-answer-right">
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                        <span>Bonne réponse : <strong><%= mistake[:correct_answer] %></strong></span>
                      </div>
                    </div>
                  </div>
                </article>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="companion-card p-4">
            <p class="mb-0">Bravo ! Tu as répondu correctement à toutes les questions.</p>
          </div>
        <% end %>
      </section>

      <div class="col-lg-12">
        <div class="companion-side">

          <section class="companion-card overflow-hidden">
            <header class="chat-header d-flex flex-wrap justify-content-between align-items-center gap-2">
              <h2 class="chat-title d-flex align-items-center gap-2 mb-0">
                <i class="fa-solid fa-robot" aria-hidden="true"></i>
                Coding Buddy
              </h2>
              <span class="chat-remaining">Échanges restants : <%= @chat.remaining_exchanges %></span>
            </header>

            <%# column-reverse en CSS : la liste s'ouvre sur le dernier message %>
            <div id="messages" class="chat-messages">
              <div class="chat-messages-list">
                <div class="chat-message">
                  <strong class="chat-author">Coding Buddy</strong>
                  <p class="mb-0">
                    <% if @mistakes.any? %>
                      Nous allons revoir ensemble les notions que tu n'as
                      pas encore maîtrisées. Par laquelle veux-tu commencer ?
                    <% else %>
                      Excellent résultat ! Souhaites-tu approfondir une notion ?
                    <% end %>
                  </p>
                </div>

                <% @messages.each do |message| %>
                  <div class="chat-message <%= "chat-message-user" if message.role == "user" %>">
                    <strong class="chat-author">
                      <%= message.role == "user" ? "Toi" : "Coding Buddy" %>
                    </strong>

                    <% if message.role == "assistant" %>
                      <div class="markdown-content">
                        <%= sanitize render_markdown(message.content) %>
                      </div>
                    <% else %>
                      <p class="chat-text mb-0"><%= message.content %></p>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="chat-footer">
              <% unless @chat.discussion_limit_reached? %>
                <%= form_with model: @message,
                              url: discuss_chat_messages_path(@chat),
                              method: :post,
                              data: { turbo: false } do |f| %>

                  <%= f.label :content, "Ta question", class: "form-label fw-semibold" %>
                  <%= f.text_area :content,
                                  class: "form-control chat-input mb-3",
                                  placeholder: "Pose ta question...",
                                  required: true,
                                  rows: 3 %>

                  <div class="text-end">
                    <%= f.submit "Envoyer", class: "btn btn-primary chat-submit" %>
                  </div>
                <% end %>
              <% else %>
                <%# Pas de classe .alert, pour que le message reste dans la discussion %>
                <p class="chat-closed mb-0">Tu as terminé ta session de discussion.</p>
              <% end %>
            </div>
          </section>

          <%= link_to "Passer au récapitulatif →",
                      recap_chat_path(@chat),
                      class: "btn btn-success companion-next w-100 mt-3" %>
        </div>
      </div>
    </div>
  </div>
