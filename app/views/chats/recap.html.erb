<div class="container py-5">

  <div class="text-center mb-4">
    <h1 class="h2">Your recap</h1>

    <p class="lead mb-0">
      You scored <strong><%= @score %></strong>
      out of <strong><%= @total %></strong>.
    </p>
  </div>

  <!-- Strengths -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">

      <h2 class="h5 text-success">Your strengths</h2>

      <% if @strengths.any? %>
        <ul>
          <% @strengths.each do |topic| %>
            <li><%= topic %></li>
          <% end %>
        </ul>
      <% else %>
        <p>Keep practicing!</p>
      <% end %>

    </div>
  </div>

  <!-- Weaknesses -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">

      <h2 class="h5 text-danger">Areas for improvement</h2>

      <% if @weaknesses.any? %>
        <ul>
          <% @weaknesses.each do |topic| %>
            <li><%= topic %></li>
          <% end %>
        </ul>
      <% else %>
        <p>Congratulations! No mistakes.</p>
      <% end %>

    </div>
  </div>

  <!-- Questions and answers -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">

      <h2 class="h5 card-title mb-3">
        Questions and answers
      </h2>

      <ul class="list-group list-group-flush">

        <% @chat.quiz_answers.includes(:question).each do |answer| %>

          <li class="list-group-item px-0">

            <div class="d-flex justify-content-between align-items-start gap-3">

              <div>
                <p class="fw-semibold mb-1">
                  <%= answer.question.content %>
                </p>

                <p class="text-muted small mb-0">
                  Your answer: <%= answer.content %>
                </p>

                <% unless answer.correct? %>

                  <p class="text-success small mb-1">
                    Correct answer:
                    <%= answer.question.choices[answer.question.correct_option] %>
                  </p>

                  <p class="small mb-0">
                    <%= answer.feedback %>
                  </p>

                <% end %>

              </div>

              <span class="badge <%= answer.correct? ? 'bg-success' : 'bg-danger' %> flex-shrink-0">

                <%= answer.correct? ? "Correct" : "Incorrect" %>

              </span>

            </div>

          </li>

        <% end %>

      </ul>

    </div>
  </div>

  <!-- Revision session -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">

      <h2 class="h5">Your revision session</h2>

      <p class="mb-0">
        Exchanges with Coding Buddy:
        <%= @chat.exchanges_count %> / <%= Chat::MAX_EXCHANGES %>
      </p>

    </div>
  </div>

  <!-- Actions -->
  <div class="text-center">

    <button class="btn btn-primary btn-lg" disabled>
      Download my cheat sheet
    </button>

    <%= link_to "Start a new quiz",
                root_path,
                class: "btn btn-outline-secondary btn-lg" %>

    <% unless user_signed_in? %>
      <p class="small text-muted mt-2 mb-0">
        You'll be asked to sign up or log in first.
      </p>
    <% end %>

  </div>

</div>
